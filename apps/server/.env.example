# 服务端口配置
PORT=3000

# 数据库路径 (SQLite数据库文件位置)
DATABASE_PATH=./sqlite.db

# 前端URL (用于CORS配置)
FRONTEND_URL=http://localhost:5173

# 百炼AI API密钥 (从 https://bailian.console.aliyun.com 获取)
# 获取方式: 控制台 -> API-KEY管理
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# OpenAI API密钥 (从 https://platform.openai.com/api-keys 获取)
# 用于生成角色和场景参考图 - 默认使用 DALL-E 2
OPENAI_API_KEY=sk-your-openai-api-key-here

# 图片生成提供商选择 (dashscope 或 openai)
# dashscope: 使用阿里千问图像模型 (qwen-image-2.0-pro)
# openai: 使用 OpenAI 图像模型 (gpt-image-2, dall-e-2, dall-e-3)
IMAGE_PROVIDER=openai

# 图片生成模型 (可选)
# DashScope: qwen-image-2.0-pro
# OpenAI: gpt-image-2 (推荐), dall-e-3, dall-e-2
IMAGE_MODEL=gpt-image-2
