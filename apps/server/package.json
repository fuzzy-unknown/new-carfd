{
  "name": "@angry-mushroom/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run ./src/index.ts",
    "db:generate": "bunx drizzle-kit generate --dialect sqlite --schema ./src/db/schema.ts",
    "db:migrate": "bun run ./src/db/migrate.ts",
    "db": "bun run db:generate && bun run db:migrate"
  },
  "dependencies": {
    "@angry-mushroom/shared": "workspace:*",
    "elysia": "^1.3",
    "drizzle-orm": "^0.44"
  },
  "devDependencies": {
    "@types/bun": "^1.3",
    "drizzle-kit": "^0.31",
    "typescript": "^5.8"
  }
}
