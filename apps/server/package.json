{
  "name": "@angry-mushroom/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run ./src/index.ts",
    "db:generate": "bunx drizzle-kit generate --dialect sqlite --schema ./src/db/schema.ts",
    "db:push": "bunx drizzle-kit push --dialect sqlite --schema ./src/db/schema.ts"
  },
  "dependencies": {
    "@angry-mushroom/shared": "workspace:*",
    "@elysiajs/cors": "^1.2",
    "@elysiajs/openapi": "^1.4.15",
    "drizzle-orm": "^0.44",
    "elysia": "^1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3",
    "drizzle-kit": "^0.31",
    "typescript": "^5.8"
  }
}
