{
  "name": "angry-mushroom",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run scripts/dev-server.ts",
    "dev:web": "bun run scripts/dev-web.ts",
    "build": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/bun": "^1.3.14"
  }
}
